def show_menu():
    """Displays the main tutorial menu."""
    print("=== PYTHON TUTORIAL ===")
    print("1. INTRODUCTION TO PROGRAMMING")
    print("2. BASIC SYNTAX, VARIABLES & DATA TYPES")
