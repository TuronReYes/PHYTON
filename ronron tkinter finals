class QuizFrame(tk.Frame):

    def __init__(self, parent, controller):
        super().__init__(parent, bg=BG_COLOR)
        self.controller = controller
        self.current_q = 0
        self.score = 0
        self.selected_opt = tk.StringVar()

        self.header = tk.Label(
            self,
            text="Python Knowledge Quiz",
            font=("Segoe UI", 14, "bold"),
            bg=CARD_BG,
            fg=ACCENT_TEAL,
            pady=15,
        )
        self.header.pack(fill="x")

        self.q_label = tk.Label(
            self,
            text="",
            font=("Segoe UI", 12, "bold"),
            bg=BG_COLOR,
            fg=TEXT_MAIN,
            wraplength=650,
            justify="left",
        )
        self.q_label.pack(anchor="w", padx=40, pady=(30, 15))

        self.opt_buttons = []
        for i in range(4):
            btn = tk.Radiobutton(
                self,
                text="",
                variable=self.selected_opt,
                value="",
                font=("Segoe UI", 11),
                bg=BG_COLOR,
                fg=TEXT_MAIN,
                selectcolor=CARD_BG,
                activebackground=BG_COLOR,
                activeforeground=ACCENT_TEAL,
                anchor="w",
            )
            btn.pack(fill="x", padx=60, pady=6)
            self.opt_buttons.append(btn)

        self.action_btn = tk.Button(
            self,
            text="Submit Answer",
            font=("Segoe UI", 11, "bold"),
            bg=ACCENT_TEAL,
            fg="#0f172a",
            relief="flat",
            cursor="hand2",
            padx=20,
            pady=10,
            command=self.next_question,
        )
        self.action_btn.pack(pady=30)

    def on_show(self):
        self.current_q = 0
        self.score = 0
        self.display_question()

    def display_question(self):
        if self.current_q < len(QUIZ_QUESTIONS):
            q_data = QUIZ_QUESTIONS[self.current_q]
            self.q_label.config(text=f"Question {self.current_q + 1} of 15:\n\n{q_data['q']}")
            self.selected_opt.set("")

            for i, opt in enumerate(q_data["opts"]):
                self.opt_buttons[i].config(text=opt, value=opt, state="normal")
            self.action_btn.config(text="Submit Answer", command=self.next_question)
        else:
            self.show_results()

    def next_question(self):
        user_ans = self.selected_opt.get()
        if not user_ans:
            messagebox.showwarning("Warning", "Please select an answer.")
            return

        if user_ans == QUIZ_QUESTIONS[self.current_q]["ans"]:
            self.score += 1

        self.current_q += 1
        self.display_question()

    def show_results(self):
        self.q_label.config(
            text=f"Quiz Completed!\n\nYour Final Score: {self.score} / {len(QUIZ_QUESTIONS)}"
        )
        for btn in self.opt_buttons:
            btn.config(state="disabled")

        self.action_btn.config(
            text="Return to Menu",
            command=lambda: self.controller.show_frame("DashboardFrame"),
        )


