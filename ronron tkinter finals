        btn_frame = tk.Frame(self, bg=BG_COLOR)
        btn_frame.pack()

        for move in ["Rock", "Paper", "Scissors"]:
            btn = tk.Button(
                btn_frame,
                text=move,
                font=("Segoe UI", 11, "bold"),
                width=12,
                bg=ACCENT_TEAL,
                fg="#0f172a",
                relief="flat",
                cursor="hand2",
                pady=10,
                command=lambda m=move.lower(): self.play_round(m),
            )
            btn.pack(side="left", padx=10)

        self.result_label = tk.Label(
            self,
            text="Make a move to start playing!",
            font=("Segoe UI", 12),
            bg=CARD_BG,
            fg=TEXT_MAIN,
            padx=30,
            pady=20,
        )
        self.result_label.pack(pady=30)

        back_btn = tk.Button(
            self,
            text="← Back to Menu",
            font=("Segoe UI", 11, "bold"),
            bg="#334155",
            fg=TEXT_MAIN,
            relief="flat",
            cursor="hand2",
            padx=20,
            pady=8,
            command=lambda: self.controller.show_frame("DashboardFrame"),
        )
        back_btn.pack(pady=10)

    def play_round(self, player_choice):
        choices = ["rock", "paper", "scissors"]
        computer_choice = random.choice(choices)

        res_text = f"You chose: {player_choice.capitalize()}\nComputer chose: {computer_choice.capitalize()}\n\n"

        if player_choice == computer_choice:
            res_text += "It's a tie!"
        elif (
            (player_choice == "rock" and computer_choice == "scissors")
            or (player_choice == "paper" and computer_choice == "rock")
            or (player_choice == "scissors" and computer_choice == "paper")
        ):
            res_text += "You win this round!"
        else:
            res_text += "Computer wins this round!"

        self.result_label.config(text=res_text)


