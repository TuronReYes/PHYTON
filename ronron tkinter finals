        )
        header.pack(fill="x")

        main_box = tk.Frame(self, bg=BG_COLOR)
        main_box.pack(fill="both", expand=True, padx=30, pady=20)

        # Login Card (Left Side)
        login_card = tk.Frame(main_box, bg=CARD_BG, padx=20, relief="groove", bd=2)
        login_card.pack(side="left", fill="both", expand=True, padx=(0, 10))

        tk.Label(login_card, text="LOGIN", font=("Segoe UI", 13, "bold"), bg=CARD_BG, fg=ACCENT_TEAL).pack(pady=(15, 10))

        tk.Label(login_card, text="Username:", font=("Segoe UI", 10), bg=CARD_BG, fg=TEXT_MUTED).pack(anchor="w")
        self.entry_user = tk.Entry(login_card, font=("Segoe UI", 11), bg="#334155", fg=TEXT_MAIN, insertbackground=TEXT_MAIN, relief="flat")
        self.entry_user.pack(fill="x", pady=(2, 10), ipady=3)

        tk.Label(login_card, text="Password:", font=("Segoe UI", 10), bg=CARD_BG, fg=TEXT_MUTED).pack(anchor="w")
        self.entry_pass = tk.Entry(login_card, font=("Segoe UI", 11), show="*", bg="#334155", fg=TEXT_MAIN, insertbackground=TEXT_MAIN, relief="flat")
        self.entry_pass.pack(fill="x", pady=(2, 20), ipady=3)

        login_btn = tk.Button(login_card, text="LOGIN", font=("Segoe UI", 11, "bold"), bg=ACCENT_TEAL, fg="#0f172a", relief="flat", cursor="hand2", command=self.login)
        login_btn.pack(fill="x", pady=10, ipady=5)

        # Register Card (Right Side)
        reg_card = tk.Frame(main_box, bg=CARD_BG, padx=20, relief="groove", bd=2)
        reg_card.pack(side="right", fill="both", expand=True, padx=(10, 0))

        tk.Label(reg_card, text="REGISTER", font=("Segoe UI", 13, "bold"), bg=CARD_BG, fg=ACCENT_TEAL).pack(pady=(15, 10))

        tk.Label(reg_card, text="New Username:", font=("Segoe UI", 10), bg=CARD_BG, fg=TEXT_MUTED).pack(anchor="w")
        self.reg_user = tk.Entry(reg_card, font=("Segoe UI", 11), bg="#334155", fg=TEXT_MAIN, insertbackground=TEXT_MAIN, relief="flat")
        self.reg_user.pack(fill="x", pady=(2, 10), ipady=3)

        tk.Label(reg_card, text="New Password:", font=("Segoe UI", 10), bg=CARD_BG, fg=TEXT_MUTED).pack(anchor="w")
        self.reg_pass = tk.Entry(reg_card, font=("Segoe UI", 11), show="*", bg="#334155", fg=TEXT_MAIN, insertbackground=TEXT_MAIN, relief="flat")
        self.reg_pass.pack(fill="x", pady=(2, 20), ipady=3)

        reg_btn = tk.Button(reg_card, text="REGISTER", font=("Segoe UI", 11, "bold"), bg=ACCENT_TEAL, fg="#0f172a", relief="flat", cursor="hand2", command=self.register)
        reg_btn.pack(fill="x", pady=10, ipady=5)

    def register(self):
        user = self.reg_user.get().strip()
        pwd = self.reg_pass.get().strip()

        if not user or not pwd:
            messagebox.showerror("Error", "Username and password cannot be blank.")
        elif user in student_accounts:
            messagebox.showerror("Error", "Username already exists!")
        else:
            student_accounts[user] = pwd
            messagebox.showinfo("Success", f"Account created for '{user}'! You can now log in.")
            self.reg_user.delete(0, tk.END)
            self.reg_pass.delete(0, tk.END)

    def login(self):
        user = self.entry_user.get().strip()
        pwd = self.entry_pass.get().strip()

        if not student_accounts:
            messagebox.showwarning("Warning", "No accounts registered yet. Please register first.")
        elif user in student_accounts and student_accounts[user] == pwd:
            self.controller.current_user = user
            messagebox.showinfo("Welcome", f"Welcome, {user}!")
            self.entry_user.delete(0, tk.END)
            self.entry_pass.delete(0, tk.END)
            self.controller.show_frame("DashboardFrame")
        else:
            messagebox.showerror("Error", "Incorrect username or password.")


