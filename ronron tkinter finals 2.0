# Color Palette
BG_COLOR = "#0f172a"
CARD_BG = "#1e293b"
ACCENT_TEAL = "#2dd4bf"
ACCENT_HOVER = "#5eead4"
ACCENT_PRIMARY = "#38bdf8"
TEXT_MAIN = "#f8fafc"
TEXT_MUTED = "#94a3b8"
DANGER_COLOR = "#f43f5e"
DANGER_HOVER = "#fb7185"


class PythonTutorialApp(tk.Tk):

    def __init__(self):
        super().__init__()
        self.title("Python Learning Tutorial Website")
        self.geometry("800x620")
        self.minsize(700, 550)
        self.configure(bg=BG_COLOR)
        self.current_user = None

        self.container = tk.Frame(self, bg=BG_COLOR)
        self.container.pack(fill="both", expand=True)
        self.container.grid_rowconfigure(0, weight=1)
        self.container.grid_columnconfigure(0, weight=1)

        self.frames = {}
        for FrameClass in (AuthFrame, DashboardFrame, LessonFrame, QuizFrame, GameFrame):
            frame = FrameClass(parent=self.container, controller=self)
            self.frames[FrameClass.__name__] = frame
            frame.grid(row=0, column=0, sticky="nsew")

        self.show_frame("AuthFrame")

    def show_frame(self, frame_name):
        frame = self.frames[frame_name]
        if hasattr(frame, "on_show"):
            frame.on_show()
        frame.tkraise()


class AuthFrame(tk.Frame):

    def __init__(self, parent, controller):
        super().__init__(parent, bg=BG_COLOR)
        self.controller = controller

        header = tk.Label(
            self,
            text="Students Login & Registration",
            font=("Segoe UI", 18, "bold"),
            bg=CARD_BG,
            fg=TEXT_MAIN,
            pady=18,
        )
        header.pack(fill="x")

        main_box = tk.Frame(self, bg=BG_COLOR)
        main_box.pack(fill="both", expand=True, padx=40, pady=30)
        main_box.grid_columnconfigure(0, weight=1)
        main_box.grid_columnconfigure(1, weight=1)
        main_box.grid_rowconfigure(0, weight=1)

        # Login Card (Left Side)
        login_card = tk.Frame(main_box, bg=CARD_BG, padx=25, pady=20, relief="groove", bd=2)
        login_card.grid(row=0, column=0, sticky="nsew", padx=(0, 15))

        tk.Label(login_card, text="LOGIN", font=("Segoe UI", 14, "bold"), bg=CARD_BG, fg=ACCENT_TEAL).pack(pady=(10, 15))

        tk.Label(login_card, text="Username:", font=("Segoe UI", 11), bg=CARD_BG, fg=TEXT_MUTED).pack(anchor="w")
        self.entry_user = tk.Entry(login_card, font=("Segoe UI", 11), bg="#334155", fg=TEXT_MAIN, insertbackground=TEXT_MAIN, relief="flat")
        self.entry_user.pack(fill="x", pady=(2, 15), ipady=4)

        tk.Label(login_card, text="Password:", font=("Segoe UI", 11), bg=CARD_BG, fg=TEXT_MUTED).pack(anchor="w")
        self.entry_pass = tk.Entry(login_card, font=("Segoe UI", 11), show="*", bg="#334155", fg=TEXT_MAIN, insertbackground=TEXT_MAIN, relief="flat")
        self.entry_pass.pack(fill="x", pady=(2, 25), ipady=4)

        self.login_btn = tk.Button(login_card, text="LOGIN", font=("Segoe UI", 11, "bold"), bg=ACCENT_TEAL, fg="#0f172a", relief="flat", cursor="hand2", command=self.login)
        self.login_btn.pack(fill="x", pady=10, ipady=6)
        self.bind_hover(self.login_btn, ACCENT_TEAL, ACCENT_HOVER)

        # Register Card (Right Side)
        reg_card = tk.Frame(main_box, bg=CARD_BG, padx=25, pady=20, relief="groove", bd=2)
        reg_card.grid(row=0, column=1, sticky="nsew", padx=(15, 0))

        tk.Label(reg_card, text="REGISTER", font=("Segoe UI", 14, "bold"), bg=CARD_BG, fg=ACCENT_TEAL).pack(pady=(10, 15))

        tk.Label(reg_card, text="New Username:", font=("Segoe UI", 11), bg=CARD_BG, fg=TEXT_MUTED).pack(anchor="w")
        self.reg_user = tk.Entry(reg_card, font=("Segoe UI", 11), bg="#334155", fg=TEXT_MAIN, insertbackground=TEXT_MAIN, relief="flat")
        self.reg_user.pack(fill="x", pady=(2, 15), ipady=4)

        tk.Label(reg_card, text="New Password:", font=("Segoe UI", 11), bg=CARD_BG, fg=TEXT_MUTED).pack(anchor="w")
        self.reg_pass = tk.Entry(reg_card, font=("Segoe UI", 11), show="*", bg="#334155", fg=TEXT_MAIN, insertbackground=TEXT_MAIN, relief="flat")
        self.reg_pass.pack(fill="x", pady=(2, 25), ipady=4)

        self.reg_btn = tk.Button(reg_card, text="REGISTER", font=("Segoe UI", 11, "bold"), bg=ACCENT_TEAL, fg="#0f172a", relief="flat", cursor="hand2", command=self.register)
        self.reg_btn.pack(fill="x", pady=10, ipady=6)
        self.bind_hover(self.reg_btn, ACCENT_TEAL, ACCENT_HOVER)

    def bind_hover(self, widget, original_color, hover_color):
        widget.bind("<Enter>", lambda e: widget.config(bg=hover_color))
        widget.bind("<Leave>", lambda e: widget.config(bg=original_color))

    def register(self):
        user = self.reg_user.get().strip()
        pwd = self.reg_pass.get().strip()

        if not user or not pwd:
            messagebox.showerror("Error", "Username and password cannot be blank.")
        elif user in student_accounts:
            messagebox.showerror("Error", "Username already exists!")
        else:
            student_accounts[user] = pwd  # Plain text storage
            messagebox.showinfo("Success", f"Account created for '{user}'! You can now log in.")
            self.reg_user.delete(0, tk.END)
            self.reg_pass.delete(0, tk.END)

    def login(self):
        user = self.entry_user.get().strip()
        pwd = self.entry_pass.get().strip()

        if not student_accounts:
            messagebox.showwarning("Warning", "No accounts registered yet. Please register first.")
        elif user in student_accounts and student_accounts[user] == pwd:  # Plain text check
            self.controller.current_user = user
            messagebox.showinfo("Welcome", f"Welcome back, {user}!")
            self.entry_user.delete(0, tk.END)
            self.entry_pass.delete(0, tk.END)
            self.controller.show_frame("DashboardFrame")
        else:
            messagebox.showerror("Error", "Incorrect username or password.")


class DashboardFrame(tk.Frame):

    def __init__(self, parent, controller):
        super().__init__(parent, bg=BG_COLOR)
        self.controller = controller

        self.welcome_lbl = tk.Label(
            self,
            text="Python Tutorial Main Menu",
            font=("Segoe UI", 16, "bold"),
            bg=CARD_BG,
            fg=ACCENT_TEAL,
            pady=15,
        )
        self.welcome_lbl.pack(fill="x")

        content = tk.Frame(self, bg=BG_COLOR)
        content.pack(fill="both", expand=True, padx=25, pady=20)
        content.grid_columnconfigure(0, weight=1)
        content.grid_columnconfigure(1, weight=1)
        content.grid_rowconfigure(0, weight=1)

        # Left Column: Lessons list
        left_panel = tk.Frame(content, bg=CARD_BG, padx=15, pady=15)
        left_panel.grid(row=0, column=0, sticky="nsew", padx=(0, 10))

        tk.Label(
            left_panel,
            text="Select a Lesson",
            font=("Segoe UI", 12, "bold"),
            bg=CARD_BG,
            fg=TEXT_MAIN,
        ).pack(anchor="w", pady=(0, 10))

        canvas = tk.Canvas(left_panel, bg=CARD_BG, highlightthickness=0)
        scrollbar = tk.Scrollbar(left_panel, orient="vertical", command=canvas.yview)
        scrollable_frame = tk.Frame(canvas, bg=CARD_BG)

        scrollable_frame.bind(
            "<Configure>",
            lambda e: canvas.configure(scrollregion=canvas.bbox("all"))
        )
        canvas.create_window((0, 0), window=scrollable_frame, anchor="nw")
        canvas.configure(yscrollcommand=scrollbar.set)

        for num, data in LESSONS.items():
            btn = tk.Button(
                scrollable_frame,
                text=data["title"],
                font=("Segoe UI", 10),
                anchor="w",
                bg="#334155",
                fg=TEXT_MAIN,
                activebackground=ACCENT_TEAL,
                activeforeground="#0f172a",
                relief="flat",
                padx=10,
                pady=6,
                cursor="hand2",
                command=lambda n=num: self.open_lesson(n),
            )
            btn.pack(fill="x", pady=3)
            btn.bind("<Enter>", lambda e, b=btn: b.config(bg="#475569"))
            btn.bind("<Leave>", lambda e, b=btn: b.config(bg="#334155"))

        canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")

        # Right Column: Activities & Actions
        right_panel = tk.Frame(content, bg=CARD_BG, padx=20, pady=20)
        right_panel.grid(row=0, column=1, sticky="nsew", padx=(10, 0))

        tk.Label(
            right_panel,
            text="Practice & Activities",
            font=("Segoe UI", 12, "bold"),
            bg=CARD_BG,
            fg=TEXT_MAIN,
        ).pack(anchor="w", pady=(0, 15))

        quiz_btn = tk.Button(
            right_panel,
            text="Knowledge Quiz About The Lessons: (15 Qs)",
            font=("Segoe UI", 11, "bold"),
            bg=ACCENT_TEAL,
            fg="#0f172a",
            relief="flat",
            cursor="hand2",
            height=2,
            command=lambda: self.controller.show_frame("QuizFrame"),
        )
        quiz_btn.pack(fill="x", pady=8)
        self.bind_hover(quiz_btn, ACCENT_TEAL, ACCENT_HOVER)

        game_btn = tk.Button(
            right_panel,
            text="Rock-Paper-Scissors Game",
            font=("Segoe UI", 11, "bold"),
            bg=ACCENT_TEAL,
            fg="#0f172a",
            relief="flat",
            cursor="hand2",
            height=2,
            command=lambda: self.controller.show_frame("GameFrame"),
        )
        game_btn.pack(fill="x", pady=8)
        self.bind_hover(game_btn, ACCENT_TEAL, ACCENT_HOVER)

        logout_btn = tk.Button(
            right_panel,
            text="Log Out",
            font=("Segoe UI", 11, "bold"),
            bg=DANGER_COLOR,
            fg="white",
            relief="flat",
            cursor="hand2",
            height=2,
            command=self.logout,
        )
        logout_btn.pack(fill="x", pady=(40, 0))
        self.bind_hover(logout_btn, DANGER_COLOR, DANGER_HOVER)

    def bind_hover(self, widget, original_color, hover_color):
        widget.bind("<Enter>", lambda e: widget.config(bg=hover_color))
        widget.bind("<Leave>", lambda e: widget.config(bg=original_color))

    def on_show(self):
        user = self.controller.current_user or "Student"
        self.welcome_lbl.config(text=f"Hi, {user} — Welcome To The Python Learning Hub!")

    def open_lesson(self, num):
        lesson_frame = self.controller.frames["LessonFrame"]
        lesson_frame.load_lesson(num)
        self.controller.show_frame("LessonFrame")

    def logout(self):
        self.controller.current_user = None
        self.controller.show_frame("AuthFrame")


class LessonFrame(tk.Frame):

    def __init__(self, parent, controller):
        super().__init__(parent, bg=BG_COLOR)
        self.controller = controller

        self.title_lbl = tk.Label(
            self,
            text="",
            font=("Segoe UI", 14, "bold"),
            bg=CARD_BG,
            fg=ACCENT_TEAL,
            pady=15,
        )
        self.title_lbl.pack(fill="x")

        self.text_area = tk.Text(
            self,
            font=("Consolas", 11),
            wrap="word",
            padx=20,
            pady=20,
            bg=CARD_BG,
            fg=TEXT_MAIN,
            insertbackground=TEXT_MAIN,
            relief="flat",
        )
        self.text_area.pack(fill="both", expand=True, padx=20, pady=20)

        back_btn = tk.Button(
            self,
            text="← Back to Menu",
            font=("Segoe UI", 11, "bold"),
            bg="#334155",
            fg=TEXT_MAIN,
            relief="flat",
            cursor="hand2",
            padx=20,
            pady=8,
            command=lambda: self.controller.show_frame("DashboardFrame"),
        )
        back_btn.pack(pady=(0, 20))
        back_btn.bind("<Enter>", lambda e: back_btn.config(bg="#475569"))
        back_btn.bind("<Leave>", lambda e: back_btn.config(bg="#334155"))

    def load_lesson(self, num):
        data = LESSONS[num]
        self.title_lbl.config(text=data["title"])
        self.text_area.config(state="normal")
        self.text_area.delete("1.0", tk.END)
        self.text_area.insert("1.0", data["content"])
        self.text_area.config(state="disabled")


class QuizFrame(tk.Frame):

    def __init__(self, parent, controller):
        super().__init__(parent, bg=BG_COLOR)
        self.controller = controller
        self.current_q = 0
        self.score = 0
        self.selected_opt = tk.StringVar()

        self.header = tk.Label(
            self,
            text="Python Knowledge Quiz",
            font=("Segoe UI", 14, "bold"),
            bg=CARD_BG,
            fg=ACCENT_TEAL,
            pady=15,
        )
        self.header.pack(fill="x")

        self.q_label = tk.Label(
            self,
            text="",
            font=("Segoe UI", 12, "bold"),
            bg=BG_COLOR,
            fg=TEXT_MAIN,
            wraplength=650,
            justify="left",
        )
        self.q_label.pack(anchor="w", padx=40, pady=(30, 15))

        self.opt_buttons = []
        for i in range(4):
            btn = tk.Radiobutton(
                self,
                text="",
                variable=self.selected_opt,
                value="",
                font=("Segoe UI", 11),
                bg=BG_COLOR,
                fg=TEXT_MAIN,
                selectcolor=CARD_BG,
                activebackground=BG_COLOR,
                activeforeground=ACCENT_TEAL,
                anchor="w",
            )
            btn.pack(fill="x", padx=60, pady=6)
            self.opt_buttons.append(btn)

        self.action_btn = tk.Button(
            self,
            text="Submit Answer",
            font=("Segoe UI", 11, "bold"),
            bg=ACCENT_TEAL,
            fg="#0f172a",
            relief="flat",
            cursor="hand2",
            padx=20,
            pady=10,
            command=self.next_question,
        )
        self.action_btn.pack(pady=30)
        self.action_btn.bind("<Enter>", lambda e: self.action_btn.config(bg=ACCENT_HOVER))
        self.action_btn.bind("<Leave>", lambda e: self.action_btn.config(bg=ACCENT_TEAL))

    def on_show(self):
        self.current_q = 0
        self.score = 0
        self.display_question()

    def display_question(self):
        if self.current_q < len(QUIZ_QUESTIONS):
            q_data = QUIZ_QUESTIONS[self.current_q]
            self.q_label.config(text=f"Question {self.current_q + 1} of 15:\n\n{q_data['q']}")
            self.selected_opt.set("")

            for i, opt in enumerate(q_data["opts"]):
                self.opt_buttons[i].config(text=opt, value=opt, state="normal")
            self.action_btn.config(text="Submit Answer", command=self.next_question)
        else:
            self.show_results()

    def next_question(self):
        user_ans = self.selected_opt.get()
        if not user_ans:
            messagebox.showwarning("Warning", "Please select an answer.")
            return

        if user_ans == QUIZ_QUESTIONS[self.current_q]["ans"]:
            self.score += 1

        self.current_q += 1
        self.display_question()

    def show_results(self):
        self.q_label.config(
            text=f"Quiz Completed!\n\nYour Final Score: {self.score} / {len(QUIZ_QUESTIONS)}"
        )
        for btn in self.opt_buttons:
            btn.config(state="disabled")

        self.action_btn.config(
            text="Return to Menu",
            command=lambda: self.controller.show_frame("DashboardFrame"),
        )


class GameFrame(tk.Frame):

    def __init__(self, parent, controller):
        super().__init__(parent, bg=BG_COLOR)
        self.controller = controller

        header = tk.Label(
            self,
            text="Rock-Paper-Scissors Mini-Game",
            font=("Segoe UI", 14, "bold"),
            bg=CARD_BG,
            fg=ACCENT_TEAL,
            pady=15,
        )
        header.pack(fill="x")

        tk.Label(
            self,
            text="Choose your move:",
            font=("Segoe UI", 12, "bold"),
            bg=BG_COLOR,
            fg=TEXT_MUTED,
        ).pack(pady=30)

        btn_frame = tk.Frame(self, bg=BG_COLOR)
        btn_frame.pack()

        for move in ["Rock", "Paper", "Scissors"]:
            btn = tk.Button(
                btn_frame,
                text=move,
                font=("Segoe UI", 11, "bold"),
                width=12,
                bg=ACCENT_TEAL,
                fg="#0f172a",
                relief="flat",
                cursor="hand2",
                pady=10,
                command=lambda m=move.lower(): self.play_round(m),
            )
            btn.pack(side="left", padx=10)
            btn.bind("<Enter>", lambda e, b=btn: b.config(bg=ACCENT_HOVER))
            btn.bind("<Leave>", lambda e, b=btn: b.config(bg=ACCENT_TEAL))

        self.result_label = tk.Label(
            self,
            text="Make a move to start playing!",
            font=("Segoe UI", 12),
            bg=CARD_BG,
            fg=TEXT_MAIN,
            padx=30,
            pady=20,
        )
        self.result_label.pack(pady=30)

        back_btn = tk.Button(
            self,
            text="← Back to Menu",
            font=("Segoe UI", 11, "bold"),
            bg="#334155",
            fg=TEXT_MAIN,
            relief="flat",
            cursor="hand2",
            padx=20,
            pady=8,
            command=lambda: self.controller.show_frame("DashboardFrame"),
        )
        back_btn.pack(pady=10)
        back_btn.bind("<Enter>", lambda e: back_btn.config(bg="#475569"))
        back_btn.bind("<Leave>", lambda e: back_btn.config(bg="#334155"))

    def play_round(self, player_choice):
        choices = ["rock", "paper", "scissors"]
        computer_choice = random.choice(choices)

        res_text = f"You chose: {player_choice.capitalize()}\nComputer chose: {computer_choice.capitalize()}\n\n"

        if player_choice == computer_choice:
            res_text += "It's a tie!"
        elif (
            (player_choice == "rock" and computer_choice == "scissors")
            or (player_choice == "paper" and computer_choice == "rock")
            or (player_choice == "scissors" and computer_choice == "paper")
        ):
            res_text += "You win this round!"
        else:
            res_text += "Computer wins this round!"

        self.result_label.config(text=res_text)


if __name__ == "__main__":
    app = PythonTutorialApp()
    app.mainloop()
