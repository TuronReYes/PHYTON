def lesson_five():
    """Covers relational/comparison operators."""
    print("\n--- LESSON 5: RELATIONAL (COMPARISON) OPERATORS ---")
    print("• Used to compare two values; always returns True or False[cite: 21].")
    print("  - == (Equal to)[cite: 21]       | Example: 10 == 10 -> True[cite: 21]")
    print("  - != (Not equal to)[cite: 21]    | Example: 10 != 5  -> True[cite: 21]")
    print("  - >  (Greater than)[cite: 21]    | Example: 10 > 5   -> True[cite: 21]")
    print("  - <  (Less than)[cite: 21]       | Example: 5 < 10   -> True[cite: 21]")
    print("  - >= (Greater/Equal)[cite: 21]   | Example: 10 >= 10 -> True[cite: 21]")
    print("  - <= (Less/Equal)[cite: 21]      | Example: 5 <= 10  -> True[cite: 21]")
    
    score = 85
    print(f"\n[Live Example] score = {score}")
    print(f"Evaluation of print(score >= 75): {score >= 75}[cite: 21]")

def lesson_six():
    """Covers if and if-else statements."""
    print("\n--- LESSON 6: CONDITIONAL STATEMENTS (if & if-else) ---")
    print("• The 'if' statement executes a block of code only when a condition is True[cite: 22].")
    print("• The 'else' statement provides an alternative action when the 'if' condition is False[cite: 22].")
    
    print("\n[Example Code]")
    print("  score = 65")
    print("  if score >= 75:")
    print("      print(\"Passed\")")
    print("  else:")
    print("      print(\"Failed\")")
    print("-> Output: Failed (since 65 is less than 75, the else block runs)[cite: 22].")

def lesson_seven():
    """Covers if-elif-else statement chains."""
    print("\n--- LESSON 7: THE if-elif-else STATEMENT ---")
    print("• Used when there are multiple conditions to evaluate[cite: 25].")
    print("• Python checks conditions from top to bottom and executes the first condition that is True[cite: 25].")
    
    print("\n[Example Code]")
    print("  score = 85")
    print("  if score >= 90:")
    print("      print(\"Excellent\")")
    print("  elif score >= 80:")
    print("      print(\"Very Good\")  <-- This block executes!")
    print("  elif score >= 75:")
    print("      print(\"Passed\")")
    print("  else:")
    print("      print(\"Failed\")")
    print("-> Output: Very Good[cite: 25]")

def lesson_eight():
    """Covers nested conditions."""
    print("\n--- LESSON 8: NESTED CONDITIONS IN PYTHON ---")
    print("• A nested condition is a condition inside another condition[cite: 26].")
    print("• The inner condition is checked only if the outer condition evaluates to True[cite: 26].")
    
    print("\n[Example Structure]")
    print("  if condition1:")
    print("      if condition2:")
    print("          # executed if both are True")
    print("      else:")
    print("          # executed if condition1 is True but condition2 is False")
    print("  else:")
    print("      # executed if condition1 is False")

def lesson_nine():
    """Covers logical operators: and, or, not."""
    print("\n--- LESSON 9: LOGICAL OPERATORS (and, or, not) ---")
    print("• Logical operators combine or reverse conditions[cite: 27].")
    print("  1. 'and': Returns True ONLY when ALL conditions are True[cite: 28, 29].")
    print("     (Tagalog reminder: AND = KAILANGAN LAHAT TRUE)[cite: 29]")
    print("  2. 'or' : Returns True when AT LEAST ONE condition is True[cite: 30, 31].")
    print("     (Tagalog reminder: OR = KAHIT ISA LANG TRUE)[cite: 31]")
    print("  3. 'not': Reverses the result of a condition (True becomes False, False becomes True).")
    
    print("\n[Live Code Example: 'not' operator]")
    is_raining = False
    print(f"is_raining = {is_raining}")
    print("if not is_raining:")
    print("    print(\"You can go outside.\")")
    print("-> Output: You can go outside (since not False becomes True).")

def lesson_ten():
    """Covers iteration and loops (for and while)."""
    print("\n--- LESSON 10: INTRODUCTION TO ITERATION (LOOPS) ---")
    print("• Iteration means repeating a process or executing a set of instructions repeatedly[cite: 32].")
    print("• Python has two main types of loops: 'for' loops and 'while' loops[cite: 34].")
    
    print("\n--- 1. The for Loop ---")
    print("• Repeats instructions for each item in a sequence; useful when the number of repetitions is known[cite: 34].")
    print("• Example code:")
    print("    for number in range(3):")
    print("        print(\"Welcome to Python!\")[cite: 32]")
    print("• Output:")
    for num in range(3):
        print(f"  {num + 1} Welcome to Python!")
        
    print("\n--- 2. The while Loop ---")
    print("• Repeats instructions while a condition is True; useful when repetition depends on a condition[cite: 34].")
    print("• Example code:")
    print("    count = 1")
    print("    while count <= 3:")
    print("        print(\"Hello!\")")
    print("        count += 1[cite: 34]")
    print("• Output:")
    count = 1
    while count <= 3:
        print(f"  {count} Hello!")
        count += 1

