class PythonTutorialApp(tk.Tk):

    def __init__(self):
        super().__init__()
        self.title("Python Learning Portal")
        self.geometry("750x600")
        self.configure(bg="#2c3e50")
        self.current_user = None

        # Container for frames
        self.container = tk.Frame(self, bg="#2c3e50")
        self.container.pack(fill="both", expand=True)
        self.container.grid_rowconfigure(0, weight=1)
        self.container.grid_columnconfigure(0, weight=1)

        self.frames = {}
        for FrameClass in (AuthFrame, DashboardFrame, LessonFrame, QuizFrame, GameFrame):
            frame = FrameClass(parent=self.container, controller=self)
            self.frames[FrameClass.__name__] = frame
            frame.grid(row=0, column=0, sticky="nsew")

        self.show_frame("AuthFrame")

    def show_frame(self, frame_name):
        frame = self.frames[frame_name]
        if hasattr(frame, "on_show"):
            frame.on_show()
        frame.tkraise()


class AuthFrame(tk.Frame):

    def __init__(self, parent, controller):
        super().__init__(parent, bg="#ecf0f1")
        self.controller = controller

        header = tk.Label(
            self,
            text="Welcome Students! 😊\nPython Learning Portal",
            font=("Helvetica", 18, "bold"),
            bg="#34495e",
            fg="white",
            pady=15,
        )
        header.pack(fill="x")

        form_frame = tk.Frame(self, bg="#ecf0f1", pady=30)
        form_frame.pack()

        tk.Label(
            form_frame,
            text="Username:",
            font=("Helvetica", 12),
            bg="#ecf0f1",
        ).grid(row=0, column=0, sticky="e", pady=5, padx=5)
        self.entry_user = tk.Entry(form_frame, font=("Helvetica", 12))
        self.entry_user.grid(row=0, column=1, pady=5, padx=5)

        tk.Label(
            form_frame,
            text="Password:",
            font=("Helvetica", 12),
            bg="#ecf0f1",
        ).grid(row=1, column=0, sticky="e", pady=5, padx=5)
        self.entry_pass = tk.Entry(form_frame, font=("Helvetica", 12), show="*")
        self.entry_pass.grid(row=1, column=1, pady=5, padx=5)

        btn_frame = tk.Frame(self, bg="#ecf0f1")
        btn_frame.pack(pady=10)

        login_btn = tk.Button(
            btn_frame,
            text="Log In",
            font=("Helvetica", 11, "bold"),
            bg="#27ae60",
            fg="white",
            width=12,
            command=self.login,
        )
        login_btn.grid(row=0, column=0, padx=10)

        register_btn = tk.Button(
            btn_frame,
            text="Register",
            font=("Helvetica", 11, "bold"),
            bg="#2980b9",
            fg="white",
            width=12,
            command=self.register,
        )
        register_btn.grid(row=0, column=1, padx=10)

    def register(self):
        user = self.entry_user.get().strip()
        pwd = self.entry_pass.get().strip()

        if not user or not pwd:
            messagebox.showerror("Error", "Username and password cannot be blank.")
        elif user in student_accounts:
            messagebox.showerror("Error", "Username already exists!")
        else:
            student_accounts[user] = pwd
            messagebox.showinfo("Success", f"Account created for '{user}'! You can now log in.")

    def login(self):
        user = self.entry_user.get().strip()
        pwd = self.entry_pass.get().strip()

        if not student_accounts:
            messagebox.showwarning("Warning", "No accounts registered yet. Please register first.")
        elif user in student_accounts and student_accounts[user] == pwd:
            self.controller.current_user = user
            messagebox.showinfo("Welcome", f"Welcome, {user}!")
            self.entry_user.delete(0, tk.END)
            self.entry_pass.delete(0, tk.END)
            self.controller.show_frame("DashboardFrame")
        else:
            messagebox.showerror("Error", "Incorrect username or password.")


