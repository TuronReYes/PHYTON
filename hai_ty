# MAIN PROGRAM EXECUTION LOOP
# ==========================================
if __name__ == "__main__":
    while True:
        show_menu()
        choice = input("\nchoose lesson (1-3, or type 'exit' to quit): ").strip()
        
        if choice == '1':
            lesson_one()
        elif choice == '2':
            lesson_two()
        elif choice == '3':
            lesson_three()
        elif choice.lower() == 'exit':
            print("\nExiting Python Tutorial. Good luck with your studies!")
            break
        else:
            print("\n[!] Invalid choice. Please enter 1, 2, or 3.")
        
        print("\n" + "="*50 + "\n")
